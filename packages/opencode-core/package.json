{
  "name": "@opencode-ai/core",
  "version": "0.1.0",
  "description": "High-performance core utilities for OpenCode",
  "main": "npm/index.js",
  "types": "npm/index.d.ts",
  "napi": {
    "name": "opencode-core",
    "targets": [
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "RUSTC_WRAPPER= cargo build --release && node script/sync-prebuild.mjs --release && node script/generate-exports.mjs --check",
    "build:debug": "RUSTC_WRAPPER= cargo build && node script/sync-prebuild.mjs && node script/generate-exports.mjs --check",
    "prepare:local": "bun run build:debug",
    "exports:sync": "node script/generate-exports.mjs",
    "exports:check": "node script/generate-exports.mjs --check",
    "bench:native": "node script/benchmark.mjs",
    "bench:compare": "node script/benchmark-compare.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "napi",
    "rust",
    "performance"
  ],
  "author": "OpenCode Team",
  "license": "MIT"
}
